<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- REPORT ACTION -->
    <record id="action_report_student_report_card" model="ir.actions.report">
        <field name="name">Report Card</field>
        <field name="model">student.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">student_management.report_student_report_card</field>
        <field name="report_file">student_management.report_student_report_card</field>
        <field name="print_report_name">'Report Card - %s' % object.name</field>
        <field name="binding_model_id" ref="model_student_student"/>
    </record>

    <!-- REPORT TEMPLATE -->
    <template id="report_student_report_card">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="student">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- HEADER -->
                        <div class="row mb-1">
                            <div class="col-3">
                                <t t-if="student.photo">
                                    <img t-att-src="'data:image/png;base64,' + student.photo.decode()"
                                         style="max-height:100px; max-width:100px; border-radius:6px;"/>
                                </t>
                            </div>
                            <div class="col-9">
                                <h2 style="margin-bottom:2px;">
                                    <t t-esc="student.name"/>
                                </h2>
                                <p style="margin:0;">
                                    <strong>Roll No:</strong>
                                    <t t-esc="student.roll_number"/>
                                </p>
                                <p style="margin:0;">
                                    <strong>Class:</strong>
                                    <t t-esc="student.class_id.display_name or 'N/A'"/>
                                </p>
                                <p style="margin:0;">
                                    <strong>Academic Year:</strong>
                                    <t t-esc="student.class_id.academic_year or 'N/A'"/>
                                </p>
                            </div>
                        </div>

                        <hr/>

                        <!-- STUDENT DETAILS -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <h4>Student Details</h4>
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Date of Birth</strong></td>
                                        <td><t t-esc="student.date_of_birth"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Age</strong></td>
                                        <td><t t-esc="student.age"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Email</strong></td>
                                        <td><t t-esc="student.email or 'N/A'"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Address</strong></td>
                                        <td><t t-esc="student.address or 'N/A'"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <h4>Class Details</h4>
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Grade</strong></td>
                                        <td><t t-esc="student.class_id.grade or 'N/A'"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Division</strong></td>
                                        <td><t t-esc="student.division_id.name or 'N/A'"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Stream</strong></td>
                                        <td><t t-esc="student.division_id.stream or 'N/A'"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Class Teacher</strong></td>
                                        <td><t t-esc="student.class_teacher_id.name or 'N/A'"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <hr/>

                        <!-- MARKS TABLE -->
                        <h4>Academic Performance</h4>
                        <table class="table table-bordered table-sm">
                            <thead style="background-color:#f0f0f0;">
                                <tr>
                                    <th class="text-center">Subject</th>
                                    <th class="text-center">Max Marks</th>
                                    <th class="text-center">Marks Obtained</th>
                                    <th class="text-center">Percentage</th>
                                    <th class="text-center">Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="student.mark_ids" t-as="mark">
                                    <tr>
                                        <td class="text-center"><t t-esc="mark.subject_id.name"/></td>
                                        <td class="text-center"><t t-esc="mark.max_marks"/></td>
                                        <td class="text-center"><t t-esc="mark.marks_obtained"/></td>
                                        <td class="text-center"><t t-esc="'%.2f' % mark.percentage"/>%</td>
                                        <td class="text-center">
                                            <t t-if="mark.percentage >= 40">
                                                <span style="color:green;">Pass</span>
                                            </t>
                                            <t t-else="">
                                                <span style="color:red;">Fail</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- SUMMARY -->
                        <div class="row mt-4">
                            <div class="col-6 offset-6">
                                <table class="table table-bordered table-sm">
                                    <tr style="background-color:#f0f0f0;">
                                        <td class="text-center"><strong>Overall Percentage</strong></td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % student.total_percentage"/>%
                                        </td>
                                    </tr>
                                    <tr style="background-color:#f0f0f0;">
                                        <td class="text-center"><strong>Grade</strong></td>
                                        <td class="text-center">
                                            <t t-esc="student.grade or 'N/A'"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-center"><strong>Result</strong></td>
                                        <td class="text-center">
                                            <t t-if="student.result == 'pass'">
                                                <strong style="color:green;">PASS</strong>
                                            </t>
                                            <t t-else="">
                                                <strong style="color:red;">FAIL</strong>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- SIGNATURES -->
                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <p>___________________________</p>
                                <p>Class Teacher Signature</p>
                            </div>
                            <div class="col-6 text-center">
                                <p>___________________________</p>
                                <p>Principal Signature</p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>