<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CLASS LIST VIEW -->
    <record id="view_school_class_list" model="ir.ui.view">
        <field name="name">school.class.list</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <list string="Classes">
                <field name="grade"/>
                <field name="academic_year"/>
            </list>
        </field>
    </record>

    <!-- CLASS FORM VIEW -->
    <record id="view_school_class_form" model="ir.ui.view">
        <field name="name">school.class.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Class Information">
                            <field name="grade"/>
                            <field name="academic_year"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- SUBJECTS -->
                        <page string="Subjects">
                            <field name="class_subject_ids">
                                <list editable="bottom" default_group_by="subject_id">
                                    <field name="subject_id" options="{'no_create': True}"/>
                                    <field name="division_id" options="{'no_create': True}"/>
                                    <field name="teacher_id" options="{'no_create': True}"
                                           domain="[('subject_ids', 'in', [subject_id])]"/>
                                </list>
                            </field>
                        </page>

                        <!-- DIVISIONS -->
                        <page string="Divisions">
                            <field name="division_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="stream"/>
                                    <field name="class_teacher_id" options="{'no_create': True}"/>
                                    <field name="class_representative_id" options="{'no_create': True}"/>
                                    <field name="student_count" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- STUDENTS -->
                        <page string="Students">
                            <field name="student_ids">
                                <list>
                                    <field name="roll_number"/>
                                    <field name="name"/>
                                    <field name="age"/>
                                    <field name="email"/>
                                    <field name="date_of_birth"/>
                                    <field name="total_percentage" string="Overall %"/>
                                    <field name="grade"/>
                                    <field name="result" widget="badge"
                                        decoration-success="result == 'pass'"
                                        decoration-danger="result == 'fail'"/>
                                </list>
                            </field>
                        </page>

                        <!-- TIMETABLES -->
                        <page string="Timetables">
                            <field name="timetable_ids">
                                <list>
                                    <field name="day"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_school_class_search" model="ir.ui.view">
        <field name="name">school.class.search</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <search string="Search Classes">
                <field name="grade"/>
                <filter name="group_grade"
                        string="Grade"
                        context="{'group_by': 'grade'}"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_school_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_school_class_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_school_class_form')})]"/>
        <field name="search_view_id" ref="view_school_class_search"/>
    </record>
</odoo>