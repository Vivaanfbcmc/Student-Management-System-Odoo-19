<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- BOOK LIST VIEW -->
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="name"/>
                <field name="subject_id"/>
                <field name="grade"/>
                <field name="edition"/>
                <field name="available_copies"/>
                <field name="issued_copies"/>
            </list>
        </field>
    </record>

    <!-- BOOK FORM VIEW -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <header>
                    <button name="action_issue_book"
                            type="object"
                            string="Issue Book"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Book Information">
                            <field name="author"/>
                            <field name="subject_id"/>
                            <field name="grade"/>
                            <field name="stream"/>
                            <field name="edition"/>
                            <field name="publisher"/>
                        </group>
                        <group string="Availability">
                            <field name="total_copies"/>
                            <field name="available_copies" readonly="1"/>
                            <field name="issued_copies" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Issue Records">
                            <field name="issue_ids">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="issue_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'returned'"
                                           decoration-danger="state == 'overdue'"
                                           decoration-info="state == 'issued'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- BOOK SEARCH VIEW -->
    <record id="view_library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Search Books">
                <field name="name"/>
                <field name="subject_id"/>
                <field name="grade"/>
                <separator/>
                <filter name="available" string="Available" domain="[('available_copies', '>', 0)]"/>
                <separator/>
                <filter name="group_grade" string="Grade" context="{'group_by': 'grade'}"/>
                <filter name="group_subject" string="Subject" context="{'group_by': 'subject_id'}"/>
            </search>
        </field>
    </record>

    <!-- ISSUE FORM VIEW (for viewing after issuing) -->
    <record id="view_library_issue_form" model="ir.ui.view">
        <field name="name">library.issue.form</field>
        <field name="model">library.issue</field>
        <field name="arch" type="xml">
            <form string="Book Issue">
                <header>
                    <button name="action_return_book" type="object" string="Return Book"
                            class="btn-primary" invisible="state == 'returned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="issued,returned"/>
                </header>
                <sheet>
                    <group>
                        <group string="Issue Information">
                            <field name="partner_id" readonly="1"/>
                            <field name="book_id" readonly="1"/>
                            <field name="member_type" readonly="1"/>
                        </group>
                        <group string="Dates">
                            <field name="issue_date" readonly="1"/>
                            <field name="due_date" readonly="1"/>
                            <field name="return_date" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_library_books" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_library_book_search"/>
    </record>

</odoo>