<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SUBJECT LIST VIEW -->
    <record id="view_subject_list" model="ir.ui.view">
        <field name="name">student.subject.list</field>
        <field name="model">student.subject</field>
        <field name="arch" type="xml">
            <list string="Subjects" editable="bottom">
                <field name="name" required="1"/>
                <field name="code" required="1"/>
                <field name="max_marks" required="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>


    <!-- SUBJECT FORM VIEW -->
    <record id="view_subject_form" model="ir.ui.view">
        <field name="name">student.subject.form</field>
        <field name="model">student.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <group>
                        <group string="Subject Details">
                            <field name="name" required="1" placeholder="e.g. Mathematics"/>
                            <field name="code" required="1" placeholder="e.g. MATH"/>
                            <field name="max_marks" required="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1" placeholder="Brief description..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Marks Recorded" name="marks">
                            <field name="mark_ids">
                                <list>
                                    <field name="student_id"/>
                                    <field name="marks_obtained"/>
                                    <field name="max_marks"/>
                                    <field name="percentage" widget="progressbar"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ACTION -->
    <record id="action_subject_list" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">student.subject</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_subject_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_subject_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first subject!
            </p>
        </field>
    </record>
</odoo>